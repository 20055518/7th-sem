ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017/hospital_queue
# Generate a unique value before deploying. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ML_API_URL=http://127.0.0.1:8001/predict
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
QR_RATE_LIMIT=10
QR_RATE_WINDOW_SECONDS=60

# SMS Notification Service
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
